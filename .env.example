# Verdent 2API — environment configuration (copy to .env and fill in)
# .env is loaded automatically on startup; real env vars take precedence.

# ── Verdent accounts ──
# Single JWT seed (used only on first run; config.json becomes the
# source of truth afterwards). Get a JWT from the Verdent desktop app
# (DevTools → Network → authorization header) or paste one in the
# dashboard at http://localhost:5084/.
VERDENT_TOKEN=

# Optional pool seed file (one JWT per line, '#' comments ignored).
# Also only used when config.json has no accounts yet.
VERDENT_TOKENS_FILE=verdent_tokens.txt

# Free-model fallback order (comma separated, first = default).
#VERDENT_MODELS=glm-5.3-flash-free,deepseek-v4-flash-free

# Server settings
PORT=5084
HOST=0.0.0.0

# Auth token for the API (clients send it as Bearer / x-api-key)
AUTH_TOKEN=d3vin

# Request timeout in milliseconds
TIMEOUT=300000

# Outbound proxy for Verdent traffic (optional; direct by default —
# inherited HTTP(S)_PROXY env vars are ignored on purpose)
#VERDENT_PROXY=http://127.0.0.1:7890

# Logging: debug | info | warn | error   (debug dumps Verdent requests/SSE)
LOG_LEVEL=info

# Persist conversation history per X-Session-Id (off by default)
#PERSIST_HISTORY=true


# Min gap between upstream calls on the Anthropic path, ms (default 1500)
#ANTHROPIC_MIN_MS=1500
